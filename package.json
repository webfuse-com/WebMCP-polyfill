{
  "name": "@webfuse-com/webmcp-polyfill",
  "version": "0.1.0",
  "author": "Thassilo M. Schiepanski",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/types/api.lib.d.ts",
  "scripts": {
    "prepare": "husky",
    "build:lib": "npx esbuild ./src/api.lib.ts --bundle --outfile=./dist/api.lib.js --platform=node --packages=external --format=esm --target=es2022",
    "build:lib:watch": "npm run build:lib -- --watch",
    "build:browser": "npx esbuild ./src/api.browser.ts --bundle --outfile=./dist/webmcp-polyfill.js",
    "build:browser:watch": "npm run build:browser -- --watch",
    "build:types": "npx tsc",
    "build": "npm run build:lib && npm run build:types && npm run build:browser",
    "test:lib": "node --experimental-strip-types --no-warnings --test './test/lib.test.ts'",
    "test:browser": "node ./test/browser.test.js",
    "test:browser:debug": "npm run test:browser -- --no-headless --keepalive",
    "test": "npm run test:lib && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webfuse-com/WebMCP-polyfill.git"
  },
  "bugs": {
    "url": "https://github.com/webfuse-com/WebMCP-polyfill/issues"
  },
  "homepage": "https://github.com/webfuse-com/WebMCP-polyfill#readme",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "puppeteer": "^24.43.1",
    "typescript": "^6.0.3"
  }
}
